---
import LastFM from "#components/LastFM.astro"
import Sidebar from "#components/Sidebar.astro"
import SidebarExpandButton from "#components/SidebarExpandButton.astro"
import Umami from "#components/Umami.astro"
import "#styles/main.css"

interface Props {
  description?: string
  title: string
}

const {description, title} = Astro.props
---

<html class="bg-c64-blue text-c64-white accent-c64-light-blue" lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      const storedOpen = localStorage.getItem("sidebar-open")
      if (
        !matchMedia("(max-width: 55.999rem)").matches &&
        (storedOpen === "false" ||
          (storedOpen === null && location.pathname.replace(/\/+$/, "") === ""))
      ) {
        document.documentElement.setAttribute("data-sidebar-collapsed", "")
      }
    </script>
    <link rel="icon" href="/assets/favicon.png" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="aspiz.uk"
      href="/rss.xml"
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="aspiz.uk weeknotes"
      href="/weeknotes/rss.xml"
    />
    <link
      rel="preload"
      href="/PiZmono.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <Umami />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
  </head>
  <body class="font-pizmono">
    <SidebarExpandButton />
    <div
      class="min-h-screen transition-[grid-template-columns] duration-200 ease-out motion-reduce:transition-none min-[56rem]:grid min-[56rem]:grid-cols-[clamp(14rem,22vw,20rem)_minmax(0,1fr)] min-[56rem]:sidebar-collapsed:grid-cols-[0_minmax(0,1fr)]"
      data-page-layout
    >
      <Sidebar currentPath={Astro.url.pathname.replace(/\/$/, "") || "/"} />
      <slot />
    </div>
    <LastFM />
    <script>
      import {bind, play} from "cuelume"

      bind()

      document.addEventListener(
        "click",
        (event) => {
          if (
            event.target instanceof Element &&
            event.target.closest("a[href]")
          ) {
            play("tick")
          }
        },
        true,
      )
    </script>
  </body>
</html>
