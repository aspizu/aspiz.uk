---
import {dirname} from "node:path"

import CornerLeftUp from "pixelarticons/svg/corner-left-up.svg"

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/"
const parentHref = pathname === "/" ? undefined : dirname(pathname)
---

{parentHref && (
  <nav aria-label="Parent page">
    <a
      aria-label="Parent"
      class="inline-flex items-center gap-1 no-underline hover:no-underline"
      href={parentHref}
      title="Parent"
    >
      <CornerLeftUp class="size-4.5" aria-hidden="true" />
      <span>Parent</span>
    </a>
  </nav>
)}
