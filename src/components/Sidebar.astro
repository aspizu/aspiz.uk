---
import ArticleTree from "#components/ArticleTree.astro"

interface Props {
  currentPath: string
}

const {currentPath} = Astro.props
---

<button
  class="fixed inset-0 z-30 hidden cursor-pointer bg-c64-black/50 transition-opacity duration-200 ease-out not-data-open:pointer-events-none not-data-open:opacity-0 motion-reduce:transition-none max-[55.999rem]:block"
  type="button"
  aria-label="Close page navigation"
  data-mobile-sidebar-backdrop
></button>

<aside
  class="fixed inset-y-0 left-0 z-40 h-dvh w-2/3 overflow-y-auto overscroll-y-none bg-c64-black px-4 py-4 transition-[translate] duration-200 ease-out motion-reduce:transition-none max-[55.999rem]:not-data-open:-translate-x-full min-[56rem]:z-20 min-[56rem]:box-border min-[56rem]:h-screen min-[56rem]:w-[clamp(14rem,22vw,20rem)] min-[56rem]:data-collapsed:-translate-x-full"
  id="site-sidebar"
  aria-label="Page navigation"
  data-mobile-sidebar
>
  <button
    class="absolute top-2 right-2 z-10 flex size-6 cursor-pointer items-center justify-center p-0 text-c64-grey before:absolute before:-top-2 before:-right-2 before:-bottom-3 before:-left-3 before:content-[''] hover:bg-c64-dark-grey"
    type="button"
    aria-label="Collapse page navigation"
    title="Collapse page navigation"
    data-mobile-sidebar-close
  >
    <span class="relative -top-px left-px" aria-hidden="true">
      &lt;
    </span>
  </button>
  <ArticleTree currentPath={currentPath} />
</aside>

<style>
  button[data-mobile-sidebar-close]:active {
    translate: 0 2px;
  }
</style>

<script>
  const sidebar = document.querySelector<HTMLElement>("[data-mobile-sidebar]")
  const openButton = document.querySelector<HTMLButtonElement>(
    "[data-mobile-sidebar-open]",
  )
  const closeButton = document.querySelector<HTMLButtonElement>(
    "[data-mobile-sidebar-close]",
  )
  const backdrop = document.querySelector<HTMLButtonElement>(
    "[data-mobile-sidebar-backdrop]",
  )
  const pageLayout = sidebar?.closest<HTMLElement>("[data-page-layout]")

  if (sidebar && openButton && closeButton && backdrop && pageLayout) {
    const mobileMedia = window.matchMedia("(max-width: 55.999rem)")
    const setSidebarOpen = (open: boolean) => {
      const desktopCollapsed = !mobileMedia.matches && !open

      sidebar.toggleAttribute("data-open", open)
      sidebar.toggleAttribute("data-collapsed", desktopCollapsed)
      openButton.toggleAttribute("data-open", open)
      openButton.toggleAttribute("data-collapsed", desktopCollapsed)
      backdrop.toggleAttribute("data-open", open)
      pageLayout.toggleAttribute("data-sidebar-collapsed", desktopCollapsed)
      openButton.setAttribute("aria-expanded", String(open))
      sidebar.inert = !open
      document.documentElement.classList.toggle(
        "overflow-hidden",
        mobileMedia.matches && open,
      )
    }

    openButton.addEventListener("click", () => {
      setSidebarOpen(true)
      closeButton.focus()
    })
    closeButton.addEventListener("click", () => {
      setSidebarOpen(false)
      openButton.focus()
    })
    backdrop.addEventListener("click", () => {
      setSidebarOpen(false)
      openButton.focus()
    })
    window.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && sidebar.hasAttribute("data-open")) {
        setSidebarOpen(false)
        openButton.focus()
      }
    })
    mobileMedia.addEventListener("change", () =>
      setSidebarOpen(!mobileMedia.matches),
    )
    setSidebarOpen(!mobileMedia.matches)
  }
</script>
