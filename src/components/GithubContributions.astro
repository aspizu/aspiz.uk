---
// Astro renders this component into static HTML at build time.
// Renders nothing when no GITHUB_TOKEN is available or the request fails.
import {execFileSync} from "node:child_process"

import {parseISO} from "date-fns"

type Day = {date: string; contributionCount: number; color: string}
type Calendar = {totalContributions: number; weeks: {contributionDays: Day[]}[]}

// GitHub's light-theme level colors, used to recover each day's intensity.
const githubLevels: Record<string, number> = {
  "#ebedf0": 0,
  "#9be9a8": 1,
  "#40c463": 2,
  "#30a14e": 3,
  "#216e39": 4,
}

// Every day renders as one square. Levels step through full color or
// checkerboard dithering: blue, white dither, white, light-green dither,
// light-green. The checkers tile evenly across neighboring blocks.

let calendar: Calendar | undefined

try {
  let token: string | undefined =
    process.env.GITHUB_TOKEN ?? import.meta.env.GITHUB_TOKEN

  if (!token) {
    token = execFileSync("gh", ["auth", "token"], {
      encoding: "utf8",
      stdio: ["ignore", "pipe", "ignore"],
    }).trim()
  }

  if (!token) throw new Error("GITHUB_TOKEN is not set")

  const response = await fetch("https://api.github.com/graphql", {
    method: "POST",
    headers: {
      Authorization: `Bearer ${token}`,
      "Content-Type": "application/json",
    },
    body: JSON.stringify({
      query: `
        query($login: String!) {
          user(login: $login) {
            contributionsCollection {
              contributionCalendar {
                totalContributions
                weeks {
                  contributionDays {
                    date
                    contributionCount
                    color
                  }
                }
              }
            }
          }
        }
      `,
      variables: {login: "aspizu"},
    }),
    signal: AbortSignal.timeout(30_000),
  })

  if (!response.ok) {
    throw new Error(`GitHub returned ${response.status}`)
  }

  const data = (await response.json()) as {
    data: {user: {contributionsCollection: {contributionCalendar: Calendar}}}
  }

  calendar = data.data.user.contributionsCollection.contributionCalendar
} catch (error) {
  console.error("Skipping contribution grid:", error)
}

const totalContributions = calendar?.totalContributions ?? 0
const days: Day[] = (calendar?.weeks ?? []).flatMap(
  (week) => week.contributionDays,
)

// The trailing-year calendar starts mid-week; pad the first column with nulls
// so every column lines up Sun..Sat, then split into 7-cell columns.
const leadingNulls = Array.from({length: parseISO(days[0].date).getDay()})
const columns: (Day | null)[] = [...leadingNulls, ...days]

const grid: (Day | null)[][] = Array.from(
  {length: Math.ceil(columns.length / 7)},
  (_, index) => columns.slice(index * 7, index * 7 + 7),
)
// Drop a partial first or last column so every rendered column is a full week.
if (grid[0].some((day) => day === null)) grid.shift()
if (grid.at(-1)!.length < 7) grid.pop()

const levelClasses = [
  "bg-c64-light-blue",
  "bg-size-[50%_50%] bg-[repeating-conic-gradient(var(--color-c64-light-blue)_0_25%,var(--color-c64-white)_0_50%)]",
  "bg-c64-white",
  "bg-size-[50%_50%] bg-[repeating-conic-gradient(var(--color-c64-white)_0_25%,var(--color-c64-light-green)_0_50%)]",
  "bg-c64-light-green",
] as const
---

{calendar && (
  <div
    class="mx-auto my-4 flex w-fit items-start overflow-x-auto pb-1"
    role="img"
    aria-label={`GitHub contribution grid, ${totalContributions} contributions in the last year`}
  >
    {grid.map((week) => (
      <div class="flex flex-col">
        {week.map((day) =>
          day ? (
            <span
              class:list={[
                "size-2",
                levelClasses[githubLevels[day.color] ?? 0],
              ]}
            />
          ) : (
            <span class="size-2" />
          ),
        )}
      </div>
    ))}
  </div>
)}
