---
import {relative, resolve} from "node:path"

import FolderIndex from "#components/FolderIndex.astro"
import LastUpdated from "#components/LastUpdated.astro"
import PageQrCode from "#components/PageQrCode.astro"
import RssLink from "#components/RssLink.astro"
import SiteLogo from "#components/SiteLogo.astro"
import UpFolderLink from "#components/UpFolderLink.astro"
import Layout from "#layouts/Layout.astro"
import {getPageSlug} from "#utils/page-slug"
import {getCollection, render} from "astro:content"
import Pencil from "pixelarticons/svg/pencil.svg"

export async function getStaticPaths() {
  const pages = await getCollection("pages")
  const routedPages = pages.map((page) => ({page, slug: getPageSlug(page)}))
  const pageSlugs = new Set(routedPages.map(({slug}) => slug))
  const folderSlugs = new Set<string>()

  for (const {slug} of routedPages) {
    const segments = slug.split("/").slice(0, -1)

    for (let depth = 1; depth <= segments.length; depth += 1) {
      folderSlugs.add(segments.slice(0, depth).join("/"))
    }
  }

  const pagePaths = routedPages.map(({page, slug}) => ({
    params: {slug},
    props: {kind: "page" as const, page},
  }))
  const folderPaths = [...folderSlugs]
    .filter((slug) => !pageSlugs.has(slug))
    .map((slug) => {
      const prefix = `${slug}/`
      const folderPages = routedPages
        .filter(({slug: pageSlug}) => pageSlug.startsWith(prefix))
        .map(({page, slug: pageSlug}) => {
          return {
            href: `/${pageSlug}`,
            title: page.data.title,
            updatedAt: page.data.updatedAt.toISOString(),
          }
        })
        .toSorted(
          (left, right) =>
            right.updatedAt.localeCompare(left.updatedAt) ||
            left.title.localeCompare(right.title),
        )

      return {
        params: {slug},
        props: {
          folder: {
            name: slug.split("/").at(-1) ?? slug,
            pages: folderPages,
          },
          kind: "folder" as const,
        },
      }
    })

  return [...pagePaths, ...folderPaths]
}

const props = Astro.props
const Content =
  props.kind === "page" ? (await render(props.page)).Content : undefined
const pageTitle =
  props.kind === "folder" ? `${props.folder.name}/` : props.page.data.title
const pageDescription =
  props.kind === "page" ? props.page.data.description : undefined
const lastUpdatedAt =
  props.kind === "page" ? props.page.data.updatedAt.toISOString() : undefined
const sourceCodeHref =
  props.kind === "page" && props.page.filePath
    ? `vscode://file${resolve(
        "/Users/aspizu/Projects/aspiz.uk",
        relative(process.cwd(), resolve(props.page.filePath)),
      )}`
    : undefined
---

<Layout description={pageDescription} title={pageTitle}>
  <div class="mx-auto w-full max-w-[80ch] px-2 text-justify text-pretty wrap-anywhere min-[56rem]:col-start-2">
    <SiteLogo class="mt-12 mb-8" />
    <div class="my-4 flex h-8 items-center justify-between gap-4">
      <div class="flex items-center gap-4">
        <UpFolderLink />
        <RssLink />
      </div>
      <div class="ml-auto flex items-center gap-4">
        {sourceCodeHref && (
          <a
            aria-label="Edit Source"
            class="source-code-link hidden no-underline hover:no-underline"
            href={sourceCodeHref}
            title="Open this page's source in VS Code"
          >
            <span class="inline-flex items-center gap-1">
              <Pencil class="size-4.5" aria-hidden="true" />
              <span>Edit</span>
            </span>
          </a>
        )}
        {lastUpdatedAt && <LastUpdated date={lastUpdatedAt} />}
      </div>
    </div>
    <main class="markdown">
      <h1>{pageTitle}</h1>
      {props.kind === "folder" ? (
        <FolderIndex folder={props.folder} />
      ) : Content ? (
        <Content />
      ) : null}
    </main>
    <PageQrCode title={pageTitle} />
  </div>
</Layout>
