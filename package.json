{
  "type": "module",
  "scripts": {
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "deploy": "pnpm build && DO_NOT_TRACK=1 pnpm exec wrangler deploy",
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "typecheck": "ASTRO_TELEMETRY_DISABLED=1 astro sync && tsc --noEmit",
    "lint": "oxfmt --check . && oxlint . && prettier --check \"**/*.{astro,jsonc,mdx,yaml,yml}\" && tailwind-lint --config .tailwind-lint.css \"src/**/*.{astro,html,js,jsx,md,mdx,svelte,ts,tsx,vue}\"",
    "format": "oxfmt . && prettier --write \"**/*.{astro,jsonc,mdx,yaml,yml}\"",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/rss": "^4.0.19",
    "@fontsource-variable/figtree": "^5.3.0",
    "astro": "^7.3.3",
    "cuelume": "^0.2.2",
    "date-fns": "^4.4.0",
    "mdast-util-find-and-replace": "^3.0.2",
    "pixelarticons": "^2.4.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/qrcode": "^1.5.6",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2002",
    "prettier": "3.9.8",
    "prettier-plugin-astro": "1.0.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwind-lint": "^0.12.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.136.2"
  }
}
